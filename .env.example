# Copy to .env.development.local (gitignored) to point `npm run dev` at a specific
# development backend instead of the local mock fallback:
#
#   cp .env.example .env.development.local
#
# The same variable set in a GitHub Actions secret (DEMOTHAT_PRODUCTION_API_BASE_URL)
# bakes the production URL into CI-built binaries. See release.yml.
#
# Precedence: shell/CI variable > this .env file > defaults in vite.config.ts.
#
# When developing against a local demothat-api instance (which runs POST /v1/ai/chat
# for the managed cloud assistant), set:
#   DEMOTHAT_DEFAULT_API_BASE_URL=http://localhost:3000
DEMOTHAT_DEFAULT_API_BASE_URL=
