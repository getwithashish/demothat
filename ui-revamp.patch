+          </p>
+        </div>
+        <div className="w-56">
+          <SegmentedControl
+            aria-label="Theme"
+            value={theme}
+            onChange={(value) => setTheme(value as Theme)}
+            options={[
+              { value: 'light', label: 'Light' },
+              { value: 'dark', label: 'Dark' },
+            ]}
+          />
+        </div>
+      </header>
+
+      <main className="mx-auto max-w-[1100px] pb-24">
+        <p className="px-[18px] py-4 text-sm text-muted">
