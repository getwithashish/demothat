diff --git a/src/styles/tokens.css b/src/styles/tokens.css
new file mode 100644
index 0000000..0bdb57b
--- /dev/null
+++ b/src/styles/tokens.css
@@ -0,0 +1,101 @@
+/* ScreenArc UI revamp: design tokens (Tailwind CSS v4)
+   Imported from src/index.css, AFTER `@import "tailwindcss";`.
+   Theme switching: set data-theme="light" | "dark" on <html>.
+   Default it from Electron's nativeTheme (or prefers-color-scheme) and let the user override. */
+
+/* Bundle these locally (woff2 in src/assets/fonts). Do NOT load from a CDN: the app must work offline.
+   Paths are relative to THIS file (src/styles/), hence ../assets/fonts/. */
+@font-face { font-family: "Public Sans"; font-weight: 400; font-display: swap; src: url("../assets/fonts/PublicSans-Regular.woff2") format("woff2"); }
+@font-face { font-family: "Public Sans"; font-weight: 500; font-display: swap; src: url("../assets/fonts/PublicSans-Medium.woff2") format("woff2"); }
+@font-face { font-family: "Public Sans"; font-weight: 600; font-display: swap; src: url("../assets/fonts/PublicSans-SemiBold.woff2") format("woff2"); }
+@font-face { font-family: "IBM Plex Mono"; font-weight: 400; font-display: swap; src: url("../assets/fonts/IBMPlexMono-Regular.woff2") format("woff2"); }
+@font-face { font-family: "IBM Plex Mono"; font-weight: 500; font-display: swap; src: url("../assets/fonts/IBMPlexMono-Medium.woff2") format("woff2"); }
+
+:root,
+[data-theme="light"] {
+  --sa-bg: #eeece8;        /* app background */
+  --sa-panel: #f6f5f2;     /* top bar, inspector, timeline */
+  --sa-stage: #dedbd5;     /* behind the preview */
+  --sa-line: #d6d3cc;      /* all 1px dividers and control borders */
+  --sa-ctl: #e7e4de;       /* control fill: inputs, buttons, slider tracks, segmented bg */
+  --sa-text: #1d1d1b;
+  --sa-muted: #66635d;
+  --sa-accent: #2f5fd0;    /* the ONLY accent. active/selected/primary only */
+  --sa-on-accent: #ffffff;
+  --sa-danger: #b3261e;    /* ASSUMPTION: not in mocks (delete button). Review. */
+  --sa-scrim: rgb(0 0 0 / 0.3); /* ASSUMPTION: modal backdrop. Not in mocks. Review. */
+  --sa-clip-screen: #cfd3da;
+  --sa-clip-audio: #bcd9d2;
+  --sa-thumb-shadow: 0 1px 3px rgb(0 0 0 / 0.4);
+  --sa-preview-shadow: 0 15px 35px rgb(0 0 0 / 0.45);
+  --sa-popover-shadow: 0 6px 20px rgb(0 0 0 / 0.14);
+  color-scheme: light;
+}
+
+[data-theme="dark"] {
+  --sa-bg: #101113;
+  --sa-panel: #17181b;
+  --sa-stage: #0b0c0d;
+  --sa-line: #2a2c31;
+  --sa-ctl: #202226;
+  --sa-text: #ebecee;
+  --sa-muted: #8e9299;
+  --sa-accent: #6c9bff;
+  --sa-on-accent: #0b1020;
+  --sa-danger: #f2766e;    /* ASSUMPTION. Review. */
+  --sa-scrim: rgb(0 0 0 / 0.6); /* ASSUMPTION. Review. */
+  --sa-clip-screen: #24272c;
+  --sa-clip-audio: #1b3a40;
+  --sa-thumb-shadow: 0 1px 3px rgb(0 0 0 / 0.4);
+  --sa-preview-shadow: 0 15px 35px rgb(0 0 0 / 0.45);
+  --sa-popover-shadow: 0 6px 20px rgb(0 0 0 / 0.55);
+  color-scheme: dark;
+}
+
+/* Derived states (spec §2): hover on a ctl-filled control shifts ~6% toward text.
+   Declared once and resolved against whichever theme is active. */
+:root {
+  --sa-ctl-hover: color-mix(in srgb, var(--sa-ctl), var(--sa-text) 6%);
+}
+
+@theme inline {
+  --color-app: var(--sa-bg);
+  --color-ctl-hover: var(--sa-ctl-hover);
+  --color-panel: var(--sa-panel);
+  --color-stage: var(--sa-stage);
+  --color-line: var(--sa-line);
+  --color-ctl: var(--sa-ctl);
+  --color-fg: var(--sa-text);
+  --color-muted: var(--sa-muted);
+  --color-accent: var(--sa-accent);
+  --color-on-accent: var(--sa-on-accent);
+  --color-danger: var(--sa-danger);
+  --color-scrim: var(--sa-scrim);
+  --color-clip-screen: var(--sa-clip-screen);
+  --color-clip-audio: var(--sa-clip-audio);
+
+  --font-sans: "Public Sans", system-ui, sans-serif;
+  --font-mono: "IBM Plex Mono", ui-monospace, monospace;
+
+  --radius-ctl: 6px;       /* buttons, selects, swatches, inputs */
+  --radius-seg: 7px;       /* segmented control, position grid */
+  --radius-clip: 5px;      /* timeline clips */
+  --radius-pv: 8px;        /* preview frame */
+
+  --text-ui: 13px;         /* base */
+  --text-title: 15px;      /* panel title */
+  --text-sm: 12px;         /* helper text, values, track names */
+  --text-label: 11px;      /* uppercase section labels */
+}
+
+@layer base {
+  html, body, #root { height: 100%; }
+  body {
+    background: var(--sa-bg);
+    color: var(--sa-text);
+    font-family: var(--font-sans);
+    font-size: 13px;
+    line-height: 1.4;
+  }
+  :focus-visible { outline: 2px solid var(--sa-accent); outline-offset: 2px; }
+}
diff --git a/vite.gallery.config.ts b/vite.gallery.config.ts
new file mode 100644
index 0000000..8e92881
--- /dev/null
+++ b/vite.gallery.config.ts
@@ -0,0 +1,20 @@
+import { defineConfig } from 'vite'
+import react from '@vitejs/plugin-react'
+import tailwindcss from '@tailwindcss/vite'
+import { nodePolyfills } from 'vite-plugin-node-polyfills'
+
+/**
+ * Renderer-only Vite config for reviewing the dev UI gallery without the Electron
+ * runtime (the Electron binary is not installed in every environment, and
+ * `vite-plugin-electron` aborts the dev server when it can't spawn it).
+ *
+ *   npx vite --config vite.gallery.config.ts
+ *   → http://localhost:5174/?ui-gallery
+ *
+ * Not used by `npm run dev`, `npm run build` or any packaged build.
+ */
+export default defineConfig({
+  base: './',
+  plugins: [tailwindcss(), react(), nodePolyfills()],
+  server: { port: 5174, strictPort: true },
+})
